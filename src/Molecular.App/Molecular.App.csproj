<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Molecular</AssemblyName>
    <OutputPath>..\..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Molecular.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.2.2</Version>
    <FileVersion>0.2.2.0</FileVersion>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <Product>Molecular Personal Audio Mixer</Product>
    <Company>Kadev</Company>
    <Description>Mixer pessoal de áudio para Windows</Description>
    <RepositoryUrl>https://github.com/kadev-code/molecular</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Molecular.Core\Molecular.Core.csproj" />
    <Resource Include="Assets\Molecular.ico" />
    <Resource Include="Assets\Molecular.png" />
  </ItemGroup>

  <!-- O app publicado permanece sempre em build\Molecular.exe. -->
  <Target Name="RemoveIntermediateAppHost" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true'">
    <Delete Files="$(IntermediateOutputPath)apphost.exe" />
  </Target>

  <Target Name="RemovePublishedIntermediateAppHost" AfterTargets="Publish">
    <Delete Files="$(IntermediateOutputPath)apphost.exe;$(IntermediateOutputPath)singlefilehost.exe" />
  </Target>

</Project>
