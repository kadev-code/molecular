<Window x:Class="Molecular.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:Molecular.App.Converters"
        Title="Molecular — Personal Audio Mixer" Icon="Assets/Molecular.ico"
        Width="1480" Height="900" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#080B12" Foreground="#F3F5FA"
        FontFamily="Segoe UI Variable Text" FontWeight="Medium" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Animated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:VolumeToFaderPositionConverter x:Key="VolumeToFaderPositionConverter" />
        <converters:SliderFillWidthConverter x:Key="SliderFillWidthConverter" />
        <converters:ResponsiveExpandedColumnsConverter x:Key="ResponsiveExpandedColumnsConverter" />
        <converters:ExpandedCardHeightConverter x:Key="ExpandedCardHeightConverter" />
        <converters:ExpandedPanelWidthConverter x:Key="ExpandedPanelWidthConverter" />
        <converters:ExpandedPanelVisibilityConverter x:Key="ExpandedPanelVisibilityConverter" />
        <converters:PeakToMeterHeightConverter x:Key="PeakToMeterHeightConverter" />
        <converters:DbToScalePositionConverter x:Key="DbToScalePositionConverter" />
        <SolidColorBrush x:Key="AppBackground" Color="#080B12" />
        <SolidColorBrush x:Key="Panel" Color="#10141E" />
        <SolidColorBrush x:Key="Card" Color="#151A25" />
        <SolidColorBrush x:Key="CardRaised" Color="#191F2C" />
        <!-- Opaque strokes are reserved for interactive controls. Large rounded
             surfaces are separated by fill contrast to avoid fractional-DPI edges. -->
        <SolidColorBrush x:Key="Border" Color="#263041" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F5FA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA5B7" />
        <SolidColorBrush x:Key="TextDisabled" Color="#626B7C" />
        <Style TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="Fant" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style x:Key="InitialFallbackText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#25D7E8" Offset="0" />
            <GradientStop Color="#7B5CFF" Offset="0.52" />
            <GradientStop Color="#D94DFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FaderGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#6C4EFF" Offset="0" />
            <GradientStop Color="#A24CFF" Offset="0.58" />
            <GradientStop Color="#D94DFF" Offset="1" />
        </LinearGradientBrush>
        <!-- Compact fader tip accent — cyan → violet, same family as brand -->
        <LinearGradientBrush x:Key="FaderKnobMark" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#25D7E8" Offset="0" />
            <GradientStop Color="#7B5CFF" Offset="0.55" />
            <GradientStop Color="#D94DFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MeterGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#28D99A" Offset="0" />
            <GradientStop Color="#79E757" Offset="0.66" />
            <GradientStop Color="#F0C84B" Offset="0.84" />
            <GradientStop Color="#FF5C6A" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Focusable="False" Opacity="0" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="34" HorizontalAlignment="Stretch">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="5" Margin="0,2" HorizontalAlignment="Center" Background="#394254" CornerRadius="2.5" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Focusable="False" Opacity="0" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Margin" Value="0,2,0,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Focusable="False" Opacity="0" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinWidth="34" VerticalAlignment="Stretch">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Height="5" Margin="2,0" VerticalAlignment="Center" Background="#394254" CornerRadius="2.5" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Focusable="False" Opacity="0" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SurfaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="#151C28" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202938" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#252C3B" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#19313B" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0" /><Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#431D29" /><Setter Property="BorderBrush" Value="#743144" /><Setter Property="Foreground" Value="#FFB3C0" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChannelActionButton" TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
            <Setter Property="Height" Value="38" /><Setter Property="MinWidth" Value="48" /><Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="MuteActionButton" TargetType="Button" BasedOn="{StaticResource ChannelActionButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Background" Value="#5A3041" /><Setter Property="BorderBrush" Value="#8C435C" /><Setter Property="Foreground" Value="#FFB4C3" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SoloActionButton" TargetType="Button" BasedOn="{StaticResource ChannelActionButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSolo}" Value="True"><Setter Property="Background" Value="#433A6E" /><Setter Property="BorderBrush" Value="#705CD1" /><Setter Property="Foreground" Value="#D6CCFF" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="CompactSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" /><Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource BrandGradient}" />
            <Setter Property="SmallChange" Value="1" /><Setter Property="LargeChange" Value="5" />
            <Setter Property="TickFrequency" Value="1" /><Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" Background="#303848" BorderThickness="0" CornerRadius="2" VerticalAlignment="Center" />
                            <Border Height="4" Background="{TemplateBinding Foreground}" BorderThickness="0" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource SliderFillWidthConverter}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" /></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" Background="#EEF2F8" BorderThickness="0" CornerRadius="8" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalFader" TargetType="Slider">
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" /><Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="250" /><Setter Property="Width" Value="54" />
            <Setter Property="SmallChange" Value="1" /><Setter Property="LargeChange" Value="5" />
            <Setter Property="TickFrequency" Value="1" /><Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- Margin must match VolumeToFaderPositionConverter.TrackTop -->
                        <Grid Margin="0,18">
                            <Border Width="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" /></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- Visible tip is the real Thumb so it always tracks the mouse -->
                                    <Thumb Width="40" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#CC1A2230" BorderBrush="#334155" BorderThickness="1" CornerRadius="11">
                                                    <Border Height="2.5" Width="18" Background="{StaticResource FaderKnobMark}" CornerRadius="1.25"
                                                            VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaTimeline" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#55FFFFFF" CornerRadius="3">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#F2FFFFFF" CornerRadius="3" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedMeter" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True" Background="Transparent">
                            <Border x:Name="PART_Indicator" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{StaticResource MeterGradient}" CornerRadius="3">
                                <Border.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,9,8" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White" Geometry="M 0,1 L 6,1 6,7 0,7 Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalMeter" TargetType="ProgressBar">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="250" /><Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="#0B0F16" CornerRadius="7" Padding="6">
                            <Border x:Name="MeterIndicator" Width="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{StaticResource MeterGradient}" CornerRadius="3">
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource PeakToMeterHeightConverter}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Border.Height>
                                <Border.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,12,10" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White" Geometry="M 1,0 L 11,0 11,7 1,7 Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaderFill" TargetType="ProgressBar">
            <Setter Property="Width" Value="64" /><Setter Property="Height" Value="250" /><Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Margin="0,18">
                            <Border x:Name="PART_Track" Width="14" HorizontalAlignment="Center" Background="#20293A" BorderThickness="0" CornerRadius="7" />
                            <Border x:Name="PART_Indicator" Width="14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{StaticResource FaderGradient}" CornerRadius="7" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" /><Setter Property="Background" Value="#151C28" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="18,0,38,0" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E9ECF3" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="11,8" />
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="8" Margin="3,1"><ContentPresenter Margin="{TemplateBinding Padding}" /></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#2A3242" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#443970" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Pill" Background="#151C28" BorderThickness="0" CornerRadius="18">
                                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#A8B0C0" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#1C2533" /></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                <Border Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#1B2230" BorderBrush="#3A465C"
                                        BorderThickness="1" CornerRadius="12">
                                    <ScrollViewer Margin="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TogglePill" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" /><Setter Property="Height" Value="26" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Track" Background="#343D4E" CornerRadius="13"><Ellipse x:Name="Knob" Width="20" Height="20" Margin="3" Fill="#DCE1EA" HorizontalAlignment="Left" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#6F50E8" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Knob" Property="Fill" Value="White" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="AppFrame" Background="{StaticResource AppBackground}" BorderThickness="0" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="#242C3A" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="28,0,16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="48" Height="48" Margin="0,0,13,0">
                            <Ellipse Width="38" Height="17" Stroke="{StaticResource BrandGradient}" StrokeThickness="2.4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="31" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse Width="38" Height="17" Stroke="{StaticResource BrandGradient}" StrokeThickness="2.4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-31" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse Width="7" Height="7" Fill="#F5F7FB" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="M O L E C U L A R" FontFamily="Segoe UI Variable Display" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="PERSONAL AUDIO MIXER" FontSize="10" Foreground="#737D90" Margin="1,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Height="58" MaxWidth="430" Margin="10,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ComboBox x:Name="OutputDeviceComboBox" Style="{StaticResource PillComboBox}" Padding="48,12,38,0" ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" ToolTip="{Binding SelectedOutputDevice.Name}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Ellipse Width="9" Height="9" Fill="#28D99A" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="SAÍDA ATIVA" FontSize="10" FontWeight="SemiBold" Foreground="#687489" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,6,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButton}" ToolTip="Selecionar dispositivo de áudio" Click="AudioDevicesButton_Click" AutomationProperties.Name="Selecionar dispositivo de áudio">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE767;" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="Abrir configurações" Click="SettingsButton_Click" AutomationProperties.Name="Abrir configurações">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                        </Button>
                        <Border Width="1" Height="28" Background="#273044" Margin="10,0" />
                        <Button Style="{StaticResource WindowButton}" Content="—" ToolTip="Minimizar" Click="MinimizeButton_Click" AutomationProperties.Name="Minimizar" />
                        <Button Style="{StaticResource WindowButton}" Content="□" ToolTip="Maximizar ou restaurar" Click="MaximizeButton_Click" AutomationProperties.Name="Maximizar ou restaurar" />
                        <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" Content="×"
                                ToolTip="{Binding CloseButtonToolTip}" Click="CloseButton_Click"
                                AutomationProperties.Name="{Binding CloseButtonToolTip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,18,26,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="302" /></Grid.ColumnDefinitions>

                <!-- Workspace -->
                <Grid x:Name="WorkspaceGrid" Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions><RowDefinition Height="203" /><RowDefinition Height="*" /><RowDefinition Height="Auto" MinHeight="44" /></Grid.RowDefinitions>

                    <!-- Canais rápidos -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="CANAIS RÁPIDOS" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox Width="150" Height="26" Margin="14,0,0,0" Padding="8,3"
                                         VerticalContentAlignment="Center"
                                         Background="#151C28" Foreground="#F2F5FA" BorderBrush="#3A465C" BorderThickness="1"
                                         CaretBrush="White" FontSize="11"
                                         Text="{Binding ChannelFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Pesquisar canais por nome"
                                         AutomationProperties.Name="Pesquisar canais" />
                                <Button Height="26" Padding="10,0" Margin="14,-5,0,0" Content="{Binding QuickInactiveButtonText}" Command="{Binding ToggleInactiveQuickChannelsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                            <Setter Property="FontSize" Value="9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowInactiveQuickChannels}" Value="True">
                                                    <Setter Property="Foreground" Value="#A98BFF" />
                                                    <Setter Property="BorderBrush" Value="#6951B9" />
                                                    <Setter Property="Background" Value="#201A35" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Height="26" Padding="10,0" Margin="8,-5,0,0" Content="{Binding QuickHiddenButtonText}" Command="{Binding ToggleHiddenQuickChannelsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                            <Setter Property="FontSize" Value="9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowHiddenQuickChannels}" Value="True">
                                                    <Setter Property="Foreground" Value="#25D7E8" />
                                                    <Setter Property="Background" Value="#13252E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding QuickPageText}" FontSize="11" Foreground="#7E889A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SurfaceButton}" Width="28" Height="26" Padding="0" Content="‹" Command="{Binding PreviousQuickPageCommand}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior de canais" />
                                <Button Style="{StaticResource SurfaceButton}" Width="28" Height="26" Padding="0" Margin="5,0,0,0" Content="›" Command="{Binding NextQuickPageCommand}" ToolTip="Próxima página" AutomationProperties.Name="Próxima página de canais" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding VisibleQuickChannels}" Margin="0,0,12,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="QuickChannelCard" Height="145" Margin="0,0,12,8" Padding="12,12" BorderThickness="0" CornerRadius="16">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Card}" />
                                                        <Setter Property="Opacity" Value="{Binding CardOpacity}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                                                <Setter Property="Background" Value="#111620" />
                                                                <Setter Property="Opacity" Value="0.62" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="40" />
                                                        <RowDefinition Height="28" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Height="4" CornerRadius="2" Background="{Binding AccentBrush}"
                                                            HorizontalAlignment="Stretch" IsHitTestVisible="False" Margin="0,0,0,8" />
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="34" Height="34">
                                                            <Ellipse Fill="#273044" />
                                                            <TextBlock Style="{StaticResource InitialFallbackText}" Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <Image Source="{Binding CompactIconSource}" Width="30" Height="30" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ApplicationName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding QuickStatusText}" FontSize="10" FontWeight="Bold" Margin="0,2,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#27D99A" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDisconnected}" Value="True"><Setter Property="Foreground" Value="#7D8799" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Foreground" Value="#F0A202" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=QuickChannelCard}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Button Style="{StaticResource SurfaceButton}" Padding="0" Width="24" Height="30" Margin="0,0,2,0" Command="{Binding MoveEarlierCommand}" ToolTip="Mover para a esquerda" AutomationProperties.Name="Mover canal para a esquerda">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE76B;" />
                                                            </Button>
                                                            <Button Style="{StaticResource SurfaceButton}" Padding="0" Width="24" Height="30" Margin="0,0,2,0" Command="{Binding MoveLaterCommand}" ToolTip="Mover para a direita" AutomationProperties.Name="Mover canal para a direita">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE76C;" />
                                                            </Button>
                                                            <Button Style="{StaticResource SurfaceButton}" Padding="0" Width="26" Height="30" Margin="0,0,2,0" Command="{Binding ToggleHiddenCommand}" ToolTip="{Binding HideActionText}" AutomationProperties.Name="{Binding HideActionText}">
                                                                <Grid Width="14" Height="12">
                                                                    <Path Data="M1,6 C3.5,2 10.5,2 13,6 C10.5,10 3.5,10 1,6 Z" Stroke="#AAB5C7" StrokeThickness="1.2" Fill="Transparent" />
                                                                    <Ellipse Width="3.5" Height="3.5" Stroke="#AAB5C7" StrokeThickness="1.2" />
                                                                    <Path Data="M2,1 L12,11" Stroke="#AAB5C7" StrokeThickness="1.3">
                                                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                                                    </Path>
                                                                </Grid>
                                                            </Button>
                                                            <Button Style="{StaticResource SurfaceButton}" Padding="0" Width="28" Height="30" Command="{Binding ToggleExpandedCommand}" ToolTip="Expandir canal" AutomationProperties.Name="Expandir canal">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE740;" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="2" Style="{StaticResource SegmentedMeter}" Value="{Binding Peak, Mode=OneWay}" Margin="0,4,0,4" />
                                                    <Grid Grid.Row="3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                                        <Button Width="34" Height="34" MinWidth="0" Padding="0" Content="M" Command="{Binding ToggleMuteCommand}" ToolTip="Mutar ou desmutar canal" VerticalAlignment="Center">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChannelActionButton}"><Setter Property="Width" Value="34" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Background" Value="#633547" /><Setter Property="Foreground" Value="#FFB5C4" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                        </Button>
                                                        <Slider Grid.Column="1" Style="{StaticResource CompactSlider}" Foreground="{StaticResource MeterGradient}" Value="{Binding TargetVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" VerticalAlignment="Center" ToolTip="Volume do canal — use a roda do mouse para ajustar ±1%" IsEnabled="{Binding IsOnline}" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel" ValueChanged="ChannelVolumeSlider_ValueChanged" />
                                                        <TextBlock Grid.Column="2" Text="{Binding VolumeDisplayText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddChannelButton" Grid.Column="1" Width="110" Height="145" Margin="0,0,0,8" Command="{Binding AddChannelCommand}" ToolTip="Adicionar aplicativo detectado" AutomationProperties.Name="Adicionar canal">
                                    <Button.Template><ControlTemplate TargetType="Button">
                                        <Grid><Rectangle Fill="#0E141E" Stroke="Transparent" StrokeThickness="0" RadiusX="16" RadiusY="16" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="+" FontSize="27" HorizontalAlignment="Center" Foreground="#9AA4B5" /><TextBlock Text="Adicionar canal" FontSize="11" Foreground="#7E889A" Margin="0,6,0,0" /></StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                    </Button.Template>
                                </Button>
                        </Grid>
                    </Grid>

                    <!-- Canais expandidos -->
                    <Grid Grid.Row="1" Margin="0,4,0,14">
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CANAIS EXPANDIDOS" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="{Binding ExpandedCountText}" FontSize="12" Foreground="{StaticResource TextDisabled}" Margin="18,0,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource SurfaceButton}" Padding="12,5" Height="30" Command="{Binding CollapseAllCommand}" ToolTip="Recolher todos os canais">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="COLAPSAR TODOS" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE73F;" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer x:Name="ExpandedChannelsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DisplayedExpandedChannels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid>
                                            <UniformGrid.Columns>
                                                <MultiBinding Converter="{StaticResource ResponsiveExpandedColumnsConverter}">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
                                                    <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
                                                </MultiBinding>
                                            </UniformGrid.Columns>
                                        </UniformGrid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                        <Border x:Name="ResponsiveExpandedCard"
                                                MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Converter={StaticResource ExpandedCardHeightConverter}}"
                                                MaxHeight="450" VerticalAlignment="Top" Margin="0,0,12,12" Padding="18" BorderThickness="0" CornerRadius="20">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#121823" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                    <Setter Property="Opacity" Value="{Binding CardOpacity}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                                            <Setter Property="Background" Value="#10151E" />
                                                            <Setter Property="BorderBrush" Value="#343C49" />
                                                            <Setter Property="Opacity" Value="0.72" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                                    <Grid Width="48" Height="48">
                                                        <Ellipse Fill="#273044" />
                                                        <TextBlock Style="{StaticResource InitialFallbackText}" Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                                                        <Image Source="{Binding ExpandedIconSource}" Width="46" Height="46" />
                                                        <Border Width="4" Height="48" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding AccentBrush}" Margin="-8,0,0,0" IsHitTestVisible="False" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ApplicationName}" FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding ExecutableName}" FontSize="11" Foreground="#929CAD" />
                                                            <TextBlock Text="  ·  " FontSize="11" Foreground="#566174" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="#28D99A" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource SurfaceButton}" Width="34" Height="40" Padding="0" Command="{Binding MoveEarlierCommand}" ToolTip="Mover para cima" AutomationProperties.Name="Mover canal para cima">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE74A;" />
                                                    </Button>
                                                    <Button Grid.Column="3" Style="{StaticResource SurfaceButton}" Width="34" Height="40" Padding="0" Command="{Binding MoveLaterCommand}" ToolTip="Mover para baixo" AutomationProperties.Name="Mover canal para baixo">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE74B;" />
                                                    </Button>
                                                    <Button Grid.Column="4" Style="{StaticResource SurfaceButton}" Width="34" Height="40" Padding="0" Command="{Binding CycleAccentCommand}" ToolTip="Alternar cor do canal" AutomationProperties.Name="Alternar cor do canal">
                                                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding AccentBrush}" />
                                                    </Button>
                                                    <Button Grid.Column="5" Style="{StaticResource SurfaceButton}" Width="34" Height="40" Padding="0" Command="{Binding TogglePinCommand}" ToolTip="{Binding PinActionText}" AutomationProperties.Name="{Binding PinActionText}">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE718;">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#AAB5C7" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                            <Setter Property="Foreground" Value="#F0A202" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button Grid.Column="6" Style="{StaticResource SurfaceButton}" Width="40" Height="40" Padding="0" Command="{Binding ToggleExpandedCommand}" ToolTip="Recolher canal">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE73F;" />
                                                    </Button>
                                                </Grid>

                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="{Binding ActualWidth, ElementName=ResponsiveExpandedCard, Converter={StaticResource ExpandedPanelWidthConverter}}" />
                                                     </Grid.ColumnDefinitions>

                                                     <Border Grid.Column="0" Padding="15" Background="#101620" BorderThickness="0" CornerRadius="14">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                                                            <TextBlock Text="CONTROLES DO CANAL" FontSize="11" FontWeight="Bold" Foreground="#C4CBD7" />
                                                            <StackPanel Grid.Row="1">
                                                                <TextBlock Text="FONTE / ATRIBUIÇÃO" FontSize="11" Foreground="#778297" Margin="3,0,0,4" />
                                                                <ComboBox Height="35" Style="{StaticResource PillComboBox}" ItemsSource="{Binding AssignmentOptions}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" ToolTip="Trocar aplicativo atribuído">
                                                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>

                                                            <Grid x:Name="ChannelLevelArea" Grid.Row="2" MinHeight="132" MaxHeight="180" Margin="4,10,4,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                                                                <Grid Grid.Column="0">
                                                                    <Grid.RowDefinitions><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding PeakDbText}" FontSize="10" FontWeight="SemiBold" Foreground="#A8B2C4" HorizontalAlignment="Left" ToolTip="Pico instantâneo do sinal" />
                                                                    <Canvas x:Name="DbScaleCanvas" Grid.Row="1" HorizontalAlignment="Left" Width="30" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                                                        <TextBlock Text="0" FontSize="9" Foreground="#758095" Canvas.Top="{Binding ActualHeight, ElementName=DbScaleCanvas, Converter={StaticResource DbToScalePositionConverter}, ConverterParameter=0}" />
                                                                        <TextBlock Text="-6" FontSize="9" Foreground="#758095" Canvas.Top="{Binding ActualHeight, ElementName=DbScaleCanvas, Converter={StaticResource DbToScalePositionConverter}, ConverterParameter=-6}" />
                                                                        <TextBlock Text="-12" FontSize="9" Foreground="#758095" Canvas.Top="{Binding ActualHeight, ElementName=DbScaleCanvas, Converter={StaticResource DbToScalePositionConverter}, ConverterParameter=-12}" />
                                                                        <TextBlock Text="-18" FontSize="9" Foreground="#758095" Canvas.Top="{Binding ActualHeight, ElementName=DbScaleCanvas, Converter={StaticResource DbToScalePositionConverter}, ConverterParameter=-18}" />
                                                                        <TextBlock Text="-30" FontSize="9" Foreground="#758095" Canvas.Top="{Binding ActualHeight, ElementName=DbScaleCanvas, Converter={StaticResource DbToScalePositionConverter}, ConverterParameter=-30}" />
                                                                        <TextBlock Text="-48" FontSize="9" Foreground="#758095" Canvas.Top="{Binding ActualHeight, ElementName=DbScaleCanvas, Converter={StaticResource DbToScalePositionConverter}, ConverterParameter=-48}" />
                                                                        <TextBlock Text="-60" FontSize="9" Foreground="#758095" Canvas.Top="{Binding ActualHeight, ElementName=DbScaleCanvas, Converter={StaticResource DbToScalePositionConverter}, ConverterParameter=-60}" />
                                                                    </Canvas>
                                                                    <ProgressBar Grid.Row="1" Style="{StaticResource VerticalMeter}" Width="30" Height="Auto" Value="{Binding Peak, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Stretch" />
                                                                </Grid>
                                                                <Grid Grid.Column="1" Width="64" MinHeight="120" MaxHeight="180" HorizontalAlignment="Center" VerticalAlignment="Stretch" ClipToBounds="False">
                                                                    <Canvas x:Name="FaderCanvas" Width="64" ClipToBounds="False" IsHitTestVisible="False">
                                                                        <Border Canvas.Left="25" Canvas.Top="18" Width="14" Background="#202838" BorderThickness="0" CornerRadius="7">
                                                                            <Border.Height>
                                                                                <MultiBinding Converter="{StaticResource VolumeToFaderPositionConverter}" ConverterParameter="TrackHeight"><Binding Path="TargetVolume" /><Binding ElementName="FaderCanvas" Path="ActualHeight" /></MultiBinding>
                                                                            </Border.Height>
                                                                        </Border>
                                                                        <Border Canvas.Left="25" Width="14" Background="{StaticResource FaderGradient}" CornerRadius="7">
                                                                            <Canvas.Top><MultiBinding Converter="{StaticResource VolumeToFaderPositionConverter}" ConverterParameter="FillTop"><Binding Path="TargetVolume" /><Binding ElementName="FaderCanvas" Path="ActualHeight" /></MultiBinding></Canvas.Top>
                                                                            <Border.Height><MultiBinding Converter="{StaticResource VolumeToFaderPositionConverter}" ConverterParameter="FillHeight"><Binding Path="TargetVolume" /><Binding ElementName="FaderCanvas" Path="ActualHeight" /></MultiBinding></Border.Height>
                                                                        </Border>
                                                                    </Canvas>
                                                                    <Slider Style="{StaticResource VerticalFader}" Height="{Binding ActualHeight, ElementName=FaderCanvas}" Width="64" Value="{Binding TargetVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Stretch" ToolTip="Volume do canal — use a roda do mouse para ajustar ±1%" IsEnabled="{Binding IsOnline}" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel" ValueChanged="ChannelVolumeSlider_ValueChanged" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <Border Width="100" Height="100" CornerRadius="50" BorderThickness="0" Background="#182131">
                                                                        <TextBlock Text="{Binding VolumeDisplayText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="Light" />
                                                                    </Border>
                                                                    <TextBlock Text="VOLUME" FontSize="11" Foreground="#8A95A7" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                                                    <TextBlock Text="{Binding EffectiveVolume, StringFormat=Saída efetiva: {0:0}%}" FontSize="10" Foreground="#657184" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Grid.Row="3">
                                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="52" /><ColumnDefinition Width="94" /></Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" Style="{StaticResource MuteActionButton}" Command="{Binding ToggleMuteCommand}" Margin="0,0,8,0" ToolTip="Mutar canal"><StackPanel Orientation="Horizontal"><TextBlock Text="M" FontWeight="Bold" Margin="0,0,9,0" /><TextBlock Text="MUTE" FontSize="11" /></StackPanel></Button>
                                                                <Button Grid.Column="1" Style="{StaticResource SoloActionButton}" Command="{Binding ToggleSoloCommand}" Margin="0,0,8,0" ToolTip="Isolar canal"><StackPanel Orientation="Horizontal"><TextBlock Text="S" FontWeight="Bold" Margin="0,0,9,0" /><TextBlock Text="SOLO" FontSize="11" /></StackPanel></Button>
                                                                <Button Grid.Column="2" Style="{StaticResource ChannelActionButton}" Command="{Binding ResetVolumeCommand}" ToolTip="Redefinir volume para 100%">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE777;" />
                                                                </Button>
                                                                <Button Grid.Column="3" Style="{StaticResource ChannelActionButton}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                                                                        Foreground="#FF8B9C" ToolTip="Remover este canal do mixer" AutomationProperties.Name="Remover canal">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE74D;" Margin="0,0,7,0" />
                                                                        <TextBlock Text="REMOVER" FontSize="10" FontWeight="Bold" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Grid.Column="1" Margin="12,0,0,0"
                                                          Visibility="{Binding ActualWidth, ElementName=ResponsiveExpandedCard, Converter={StaticResource ExpandedPanelVisibilityConverter}}">
                                                        <Border Padding="14" Background="#101620" BorderThickness="0" CornerRadius="14">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="20" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="1" />
                                                                    <RowDefinition Height="62" />
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Text="{Binding MediaHeading}" FontSize="11" FontWeight="Bold" Foreground="#C4CBD7" />

                                                                <Border Grid.Row="1" Margin="0,8,0,12" Background="{Binding MediaBackdropBrush}"
                                                                        BorderThickness="0" CornerRadius="12"
                                                                        RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Grid>
                                                                        <Border CornerRadius="11" IsHitTestVisible="False">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding MediaThumbnailSource}"
                                                                                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                                            Opacity="{Binding MediaBackdropImageOpacity}" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <Border Background="#A8121620" CornerRadius="11" IsHitTestVisible="False" />

                                                                        <Grid Margin="18,14">
                                                                            <Grid.Style>
                                                                                <Style TargetType="Grid">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers><DataTrigger Binding="{Binding HasMediaSession}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                                </Style>
                                                                            </Grid.Style>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="142" /></Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>

                                                                            <StackPanel VerticalAlignment="Center" Margin="2,0,16,0">
                                                                                <TextBlock Text="{Binding MediaTitle}" FontFamily="Segoe UI Variable Display"
