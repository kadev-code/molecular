                    </Grid>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource SurfaceButton}" Margin="0,0,8,8" Padding="12,8"
                                Command="{Binding CreateProfileCommand}" Content="Novo" />
                        <Button Style="{StaticResource SurfaceButton}" Margin="0,0,8,8" Padding="12,8"
                                Command="{Binding DuplicateProfileCommand}" Content="Duplicar" />
                        <Button Style="{StaticResource SurfaceButton}" Margin="0,0,8,8" Padding="12,8"
                                Command="{Binding SetDefaultProfileCommand}" Content="Tornar padrão" />
                        <Button Style="{StaticResource SurfaceButton}" Margin="0,0,8,8" Padding="12,8"
                                Command="{Binding ExportProfileCommand}" Content="Exportar" ToolTip="Exportar perfil ativo sem dados sensíveis" />
                        <Button Style="{StaticResource SurfaceButton}" Margin="0,0,8,8" Padding="12,8"
                                Command="{Binding ImportProfileCommand}" Content="Importar" ToolTip="Importar perfil de arquivo" />
                        <Button Style="{StaticResource SurfaceButton}" Margin="0,0,0,8" Padding="12,8"
                                Command="{Binding DeleteProfileCommand}" Content="Excluir" Foreground="#FFB4C3"
                                ToolTip="Exclui o perfil ativo. Também é possível escolher 'Sem perfil' na lista." />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
